# Copie para .env e troque a senha de exemplo por uma senha local forte.
# Este arquivo não contém uma credencial de uso real.
MSSQL_SA_PASSWORD=Troque_Esta_Senha_2026!

# Use a URL local no Streamlit executado no Windows/WSL.
# No Docker, o host do SQL Server é o nome do serviço: pizza_sql_server.
# Se não for usar SQL Server, deixe as URLs vazias e use os CSVs normalizados.
PIZZA_DATABASE_URL=mssql+pyodbc://sa:Troque_Esta_Senha_2026%21@localhost:1433/PizzaSales?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
PIZZA_DATABASE_URL_DOCKER=mssql+pyodbc://sa:Troque_Esta_Senha_2026%21@pizza_sql_server:1433/PizzaSales?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
